---
permalink: /index.html
eleventyExcludeFromCollections: true
---
{% set themeStorageKey = "gas-pages-theme" %}
<!DOCTYPE html>
<html lang="ja" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ site.title }}</title>
    <script>
      (function () {
        try {
          var theme = window.localStorage.getItem("{{ themeStorageKey }}");
          if (theme === "light" || theme === "dark" || theme === "system") {
            document.documentElement.setAttribute("data-theme", theme);
          }
        } catch (error) {
          // Keep data-theme="system" when storage is blocked.
        }
      })();
    </script>
    <style>
      {% include "theme-vars.njk" %}
      {% include "styles.css" %}
    </style>
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <p class="brand">{{ site.title }}</p>
        <nav class="nav" aria-label="ページ">
          {% for page in collections.pages %}
          <a href="#{{ page.fileSlug }}"{% if loop.first %} aria-current="page"{% endif %}>{{ page.data.title }}</a>
          {% endfor %}
        </nav>
        <div class="theme-switch" role="radiogroup" aria-label="配色">
          <button type="button" role="radio" data-theme-value="system">システム</button>
          <button type="button" role="radio" data-theme-value="light">ライト</button>
          <button type="button" role="radio" data-theme-value="dark">ダーク</button>
        </div>
      </aside>
      <div class="main">
        {% if collections.pages.length %}
          {% for page in collections.pages %}
          <article class="article" id="{{ page.fileSlug }}" data-page{% if not loop.first %} hidden{% endif %}>
            <h1>{{ page.data.title }}</h1>
            {{ page.templateContent | safe }}
          </article>
          {% endfor %}
        {% else %}
          <p class="empty">表示するページがありません。docs/pages/ に Markdown を追加してください。</p>
        {% endif %}
        <footer class="footer">
          {% if site.footerImage %}
          <img src="{{ site.footerImage }}" alt="" />
          {% endif %}
          <p>{{ site.copyright }}</p>
        </footer>
      </div>
    </div>
    <script>
      {% include "script.js" %}
      {% include "app.js" %}
    </script>
  </body>
</html>
